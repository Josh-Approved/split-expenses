    "tweetnacl-util": "^0.15.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^56.0.14",
    "jest": "^29.7.0",
    "jest-expo": "^56.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 expo run:ios",
    "web": "expo start --web",
    "test": "jest"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg))"
    ]
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "@types/jest",
        "expo",
        "expo-camera",
        "expo-file-system",
        "expo-font",
        "expo-image-picker",
        "expo-linking",
        "expo-notifications",
        "expo-sharing",
        "expo-sqlite",
        "jest-expo"
      ]
    }
  }
}

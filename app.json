{
  "expo": {
    "name": "Split Expenses",
    "slug": "split-expenses",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.joshapproved.splitexpenses",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleName": "Split Expenses"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E4D8C"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.joshapproved.splitexpenses",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "josh-approved",
    "scheme": "splitexpenses",
    "plugins": [
      "./plugins/withGradleJvmArgs",
      "expo-sqlite",
      "expo-font",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan a group's QR code to join it, or snap a receipt to attach to an expense.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach a receipt photo to an expense.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAFAF7"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "41a8febe-b9ff-4d17-b238-d4ca4bf81a4d"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/41a8febe-b9ff-4d17-b238-d4ca4bf81a4d"
    }
  }
}

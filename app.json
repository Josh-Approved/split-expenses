{
  "expo": {
    "name": "Split Expenses",
    "slug": "split-expenses",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.joshapproved.splitexpenses",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E4D8C"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.joshapproved.splitexpenses"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "josh-approved",
    "scheme": "splitexpenses",
    "plugins": [
      "./plugins/withGradleJvmArgs",
      "expo-sqlite",
      "expo-font",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan a group's QR code to join it, or snap a receipt to attach to an expense."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach a receipt photo to an expense."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAFAF7"
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}
